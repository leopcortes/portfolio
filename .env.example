# ---------------------------------------------------------------------------
# Banco (PostgreSQL)
# ---------------------------------------------------------------------------
# DATABASE_URL: usada em runtime pela aplicação.
# DIRECT_URL:   usada pelo `prisma migrate`, que precisa de conexão direta.
#
# Local (sem pooler): as duas apontam para o mesmo lugar.
DATABASE_URL="postgresql://usuario@localhost:5432/portfolio"
DIRECT_URL="postgresql://usuario@localhost:5432/portfolio"
#
# Produção com pooler (Neon, Supabase, Vercel Postgres):
#   DATABASE_URL = string COM pooler   (.../db?pgbouncer=true  ou  host "-pooler")
#   DIRECT_URL   = string SEM pooler
# Serverless abre uma conexão por invocação; sem pooler o banco esgota o limite.

# ---------------------------------------------------------------------------
# NextAuth
# ---------------------------------------------------------------------------
# Gere com: openssl rand -base64 32
NEXTAUTH_SECRET=""
# Local: http://localhost:3000
# Produção: a URL canônica do site, ex. https://seudominio.com
NEXTAUTH_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Único usuário do sistema — quem pode escrever em /admin
# ---------------------------------------------------------------------------
ADMIN_USERNAME="admin"
ADMIN_PASSWORD=""
