// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

/// Linha única (id = 1) com os textos de abertura do portfólio.
model Perfil {
    id             Int      @id @default(1)
    nome           String
    titulo         String
    dataNascimento DateTime
    fotoUrl        String
    curriculoUrl   String
    localizacao    String
    bio            String
    tituloSobre    String
    tituloProjetos String
    textoProjetos  String

    tituloExperiencias String @default("Minhas experiências profissionais")

    tituloContato String
    textoContato  String

    atualizadoEm DateTime @updatedAt
}

model Experiencia {
    id          Int       @id @default(autoincrement())
    organizacao String
    cargo       String
    local       String
    url         String?
    dataInicio  DateTime
    /// null significa "Presente"
    dataFim     DateTime?
    atividades  String[]
    ordem       Int       @default(0)
    visivel     Boolean   @default(true)

    @@index([ordem])
}

model Projeto {
    id          Int              @id @default(autoincrement())
    titulo      String
    descricao   String
    categoria   CategoriaProjeto
    url         String?
    imagemUrl   String?
    tecnologias String[]
    ordem       Int              @default(0)
    visivel     Boolean          @default(true)

    @@index([ordem])
}

model CategoriaSkill {
    id     Int     @id @default(autoincrement())
    nome   String  @unique
    ordem  Int     @default(0)
    skills Skill[]

    @@index([ordem])
}

model Skill {
    id          Int            @id @default(autoincrement())
    nome        String
    /// Rótulo opcional exibido entre parênteses, ex: "Avançado"
    nivel       String?
    ordem       Int            @default(0)
    categoriaId Int
    categoria   CategoriaSkill @relation(fields: [categoriaId], references: [id], onDelete: Cascade)

    @@index([categoriaId, ordem])
}

model Contato {
    id      Int         @id @default(autoincrement())
    rotulo  String
    valor   String
    url     String?
    acao    AcaoContato
    ordem   Int         @default(0)
    visivel Boolean     @default(true)

    @@index([ordem])
}

enum CategoriaProjeto {
    EMPRESA_JUNIOR
    UNIVERSIDADE
    PESSOAL
    PROFISSIONAL
}

enum AcaoContato {
    COPIAR
    LINK
}
